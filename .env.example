# ─── Database ────────────────────────────────────────────────────
# Local Docker Postgres (dev):
DATABASE_URL=postgresql://tanda:tanda_dev_pass@localhost:54322/tanda?sslmode=disable
# Cloud Supabase (prod) — use Session mode pooler or direct URI:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── AI / LLM (OpenAI-compatible — LM Studio) ─────────────────────
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=local-model
OPENAI_API_KEY=lm-studio
OPENAI_TIMEOUT=10m
# Retries per email on transient LLM errors (HTTP 5xx, connection errors)
OPENAI_RETRY_MAX=3
OPENAI_RETRY_BASE=2s

# ─── AI system prompt ─────────────────────────────────────────────
# The studio-specific intake prompt lives outside the repo (it contains private
# business details). Point to that file; if unset/missing a generic prompt is used.
# Copy prompts/intake-system.prompt.example to prompts/intake-system.prompt and edit.
AI_SYSTEM_PROMPT_FILE=prompts/intake-system.prompt

# ─── Gmail (worker only) ─────────────────────────────────────────
GMAIL_CREDENTIALS=./credentials.json
GMAIL_TOKEN=./token.json
GMAIL_USER_EMAIL=your-studio@example.com
# Studio's own phone (normalized automatically) — excluded from customer extraction
STUDIO_PHONE=(555) 010-9999
# Website form relay(s) — comma-separated envelope addresses (e.g. Resend)
GMAIL_FORM_FROM=onboarding@yourdomain.example
# Optional extra Gmail search filter (usually leave empty; LLM decides is_lead)
# GMAIL_INTAKE_QUERY=
# How far back to fetch on worker startup only (24h default). Use 168h or 7d for testing.
# GMAIL_INITIAL_LOOKBACK=168h
# Worker poll intervals (Go duration: 30s, 2m, 1h)
GMAIL_POLL_INTERVAL=2m
SEND_POLL_INTERVAL=30s

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
ENV=local
