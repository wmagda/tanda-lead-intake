# ─── Database ────────────────────────────────────────────────────
# Supabase pooler connection string or local Postgres URL.
# Example Supabase:
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Example local (docker-compose):
#   DATABASE_URL=postgresql://tanda:tanda_dev_pass@localhost:54322/tanda?sslmode=disable

# ─── AI Inference ──────────────────────────────────────────────
# LM Studio / Ollama-compatible OpenAI endpoint
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# or
AI_BASE_URL=http://localhost:1234/v1
AI_API_KEY=

# ─── Gmail ─────────────────────────────────────────────────────
# Service account JSON or OAuth redirect.
GMAIL_CREDENTIALS=/app/credentials.json
GMAIL_TOKEN=/app/token.json
GMAIL_USER_EMAIL=hello@salsa-collective.com

# ─── Server ────────────────────────────────────────────────────
PORT=8080
ENV=local

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
